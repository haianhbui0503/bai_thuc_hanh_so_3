# Bai 19
lst = [10, 22, 28, 29, 30, 40]
N = int(input("Nhập một số nguyên N: "))
thoan_man = None
gan_nhat = float('inf')
for i in range(len(lst)):
    for j in range(i + 1, len(lst)):
        tong = lst[i] + lst[j]
        diff = abs(tong - N)
        if diff < gan_nhat:
            gan_nhat = diff
            thoa_man = (lst[i], lst[j])
print("Cặp phần tử có tổng gần nhất với N:", thoa_man)

# Bai 20
matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]
cheo_chinh = 0
cheo_phu = 0
n = len(matrix)
for i in range(n):
    cheo_chinh += matrix[i][i]
    cheo_phu += matrix[i][n - 1 - i]
ma_tran_moi = tuple(tuple(row) for row in matrix)

print("Câu 20:")
print("- Tổng đường chéo chính:", cheo_chinh)
print("- Tổng đường chéo phụ:", cheo_phu)
print("- Ma trận dạng tuple of tuple:", ma_tran_moi)
