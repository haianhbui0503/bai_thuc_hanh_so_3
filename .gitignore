#Bai6
danh_sach_6_1 = ['hello', 'hi', 'world', 'hello', 'haha', 'hi']
danh_sach_6_2 = []
for i in range (1,len(danh_sach_6_1)+1):
  danh_sach_6_2.append(danh_sach_6_1[-i])
print(danh_sach_6_2)

