# Bai 17
data = [
    {"name": "A", "score": 7},
    {"name": "B", "score": 9},
    {"name": "A", "score": 8}
]
summary = {}
for item in data:
    name = item["name"]
    score = item["score"]
    if name in summary:
        summary[name].append(score)
    else:
        summary[name] = [score]
print("Tổng điểm theo tên:")
for name, score_list in summary.items():
    print(f"{name}: {score_list}")

