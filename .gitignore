#Bai4
danh_sach_4 = ('hello','sample','world',1,2,3)
x = input("Nhập từ bàn phím:")
if str(x) in danh_sach_4:
  print(f"{x} nằm trong tuple")
elif int(x) in danh_sach_4:
  print(f"{x} nằm trong tuple")
else:
  print(f"{x} không nằm trong tuple")

